{
  "name": "soduwork",
  "productName": "SoduWork",
  "version": "1.12.98",
  "description": "SoduWork - 企业级 AI Native 工作平台",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start-client.cjs",
    "start:raw": "electron .",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 tests/*.test.cjs main/agent-runtime/*.test.js main/conversation/*.test.js main/pi-session/*.test.js",
    "check:branding": "node ../tools/brand-keyword-gate.cjs",
    "check:layout": "node ../tools/check-repository-layout.cjs",
    "check:source-size": "node ../tools/check-source-size.cjs",
    "check:security": "node ../tools/check-unsanitized-html.cjs",
    "test:e2e:user": "node e2e/user-journeys.mjs",
    "test:e2e:local": "node e2e/verify-local.cjs",
    "test:e2e:runtime-process": "node e2e/agent-runtime-process.cjs && node e2e/agent-runtime-storage.cjs",
    "test:e2e:runtime-stream": "node e2e/agent-runtime-stream-performance.cjs",
    "test:e2e:session-isolation": "node e2e/new-session-isolation.cjs && node e2e/workbench-session-races.cjs && node e2e/current-work-output-scope.cjs",
    "test:e2e:multi-runtime-plugin": "node e2e/multi-runtime-plugin.cjs",
    "test:e2e:memory": "node e2e/session-memory-personal.cjs && node e2e/personal-memory-automatic.cjs && node e2e/session-memory-import.cjs",
    "prepare:pi-cache": "node scripts/patch-pi-extension-cache.cjs",
    "prepare:shell-runtime": "node scripts/prepare-shell-runtime.cjs",
    "prepare:runner": "node scripts/prepare-runner.cjs",
    "prebuild": "npm run prepare:runner && npm run prepare:pi-cache && npm run prepare:shell-runtime",
    "prebuild-portable": "npm run prepare:runner && npm run prepare:pi-cache && npm run prepare:shell-runtime",
    "prebuild:mac": "npm run prepare:pi-cache && npm run prepare:shell-runtime",
    "prebuild:linux": "npm run prepare:runner && npm run prepare:pi-cache && npm run prepare:shell-runtime",
    "build": "electron-builder --win nsis",
    "build:dir": "electron-builder --win --dir",
    "build-portable": "electron-builder --win portable",
    "build:mac": "node scripts/build-macos.cjs",
    "build:linux": "electron-builder --linux",
    "check:licenses": "node ../tools/check-third-party.cjs",
    "test:source": "node --test ../tools/source-manifest.test.cjs"
  },
  "homepage": "",
  "author": "SoduWork",
  "license": "MIT",
  "desktopName": "soduwork.desktop",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.soduwork.app",
    "afterPack": "scripts/prepare-installer.cjs",
    "afterSign": "scripts/prepare-installer.cjs",
    "productName": "SoduWork",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "desk.html",
      "app-window-chrome.html",
      "sdk/**/*",
      "desk-boot.js",
      "desk-window.css",
      "api.js",
      "api-library-local.js",
      "version.json",
      "update-trust.json",
      "scripts/patch-pi-extension-cache.cjs",
      "THIRD_PARTY_NOTICES.md",
      "icon.ico",
      "icon.png",
      "package.json",
      "main/**/*",
      "core/**/*",
      "app/**/*",
      "components/**/*",
      "vendor/**/*",
      "theme/**/*",
      "assets/**/*",
      "!**/*.test.js",
      "!**/*.test.cjs",
      "!components/team/node_modules/**",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../hub-backend/app/agent_catalog.json",
        "to": "agent_catalog.json"
      },
      {
        "from": "../hub-backend/plugins/product-incubator.json",
        "to": "product-incubator-plugin.json"
      },
      {
        "from": ".runtime/pi",
        "to": "pi"
      },
      {
        "from": "node_modules/ssh2",
        "to": "ssh2",
        "filter": [
          "**/*",
          "!**/test/**",
          "!**/examples/**"
        ]
      },
      {
        "from": "node_modules/asn1",
        "to": "ssh2/node_modules/asn1",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/bcrypt-pbkdf",
        "to": "ssh2/node_modules/bcrypt-pbkdf",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/safer-buffer",
        "to": "ssh2/node_modules/safer-buffer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/tweetnacl",
        "to": "ssh2/node_modules/tweetnacl",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../skills",
        "to": "skills",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/node_modules/**",
          "!**/.venv/**",
          "!**/.git/**",
          "!browser-use/after-login.png",
          "!browser-use/browser_baidu.png",
          "!browser-use/clean-login-filled.png",
          "!browser-use/login-filled.png",
          "!browser-use/login-retry-filled.png",
          "!browser-use/out.png",
          "!browser-use/scripts/arch.png"
        ]
      },
      {
        "from": "../third-party",
        "to": "third-party"
      },
      {
        "from": ".runtime/compliance",
        "to": "third-party/inventory"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "runner",
          "to": "runner",
          "filter": [
            "soduwork-runner.exe",
            "soduwork-runner"
          ]
        }
      ]
    },
    "nsis": {
      "guid": "35643c48-76d7-54ae-9c89-cc281f9a86a4",
      "artifactName": "SoduWork-${version}-Setup.exe",
      "include": "build/installer.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoduWork"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "SoduWork-${version}-mac-${arch}.${ext}",
      "extraResources": [
        {
          "from": "runner",
          "to": "runner",
          "filter": [
            "soduwork-runner"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "tar.gz"
      ],
      "icon": "build/icons",
      "category": "Office",
      "executableName": "soduwork",
      "maintainer": "SoduWork <maintainer@example.com>",
      "syncDesktopName": true,
      "artifactName": "SoduWork-${version}-linux.${ext}",
      "extraResources": [
        {
          "from": "runner",
          "to": "runner",
          "filter": [
            "soduwork-runner"
          ]
        }
      ]
    },
    "deb": {
      "packageName": "soduwork",
      "packageCategory": "utils",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2"
      ]
    },
    "rpm": {
      "packageName": "soduwork",
      "packageCategory": "Office",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "mesa-libgbm",
        "(libuuid or libuuid1)",
        "alsa-lib"
      ]
    },
    "beforePack": "scripts/prepare-third-party.cjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "@earendil-works/pi-coding-agent@1.4.0": {
      "undici": "8.12.2"
    },
    "node-gyp": {
      "undici": "6.29.1"
    }
  }
}
