    "test:org-memory:browser": "node tests/run-org-memory-browser.cjs",
    "test:cloud-runners:browser": "npm run build && node tests/run-cloud-runner-management-browser.cjs",
    "test:public-pages:browser": "npm run build && node tests/public-pages-browser.cjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "dompurify": "3.4.17",
    "franc-min": "6.2.0",
    "jszip": "3.10.1",
    "mammoth": "1.13.0",
    "marked": "18.0.9",
    "react": "^18.3.1",
    "react-dom": "^19.3.1",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7"
  }
}
