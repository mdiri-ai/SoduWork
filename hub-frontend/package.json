{
  "name": "hub-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SoduWork 企业级 AI Native 管理端（React + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:i18n": "node --test tests/i18n.test.mjs",
