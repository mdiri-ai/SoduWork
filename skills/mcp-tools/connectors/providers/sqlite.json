{
  "schemaVersion": 1,
  "id": "sqlite",
  "name": "SQLite",
  "category": "数据库",
  "description": "查看 SQLite 表、字段和数据，向已授权的普通表新增单条记录。",
  "runtimeKind": "sqlite",
  "officialDocs": [
    "https://www.sqlite.org/uri.html",
    "https://www.sqlite.org/fileformat2.html",
    "https://www.sqlite.org/pragma.html#pragma_table_info",
    "https://www.sqlite.org/lang_select.html"
  ],
  "authDocs": [
    "https://www.sqlite.org/uri.html"
  ],
  "baseUrl": "http://sqlite-runtime.local",
  "fields": [
    {
      "key": "SQLITE_PATH",
      "label": "SQLite 数据库文件路径（绝对路径；文件必须已存在，连接器不创建新文件）",
      "secret": false,
      "required": true,
      "pattern": "^(?:[A-Za-z]:[\\\\/]|/)[^\\x00-\\x1f<>|:*?\"]{0,999}$",
      "example": ""
    },
    {
      "key": "SQLITE_INSERT_TABLES",
      "label": "允许新增的表（多个表名用英文逗号分隔）",
      "secret": false,
      "required": false,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}(?: *, *[A-Za-z_][A-Za-z0-9_]{0,62})*$",
      "example": "city, product"
    }
  ],
  "auth": {
    "type": "none"
  },
  "headers": {},
  "tools": [
    {
      "name": "list_tables",
      "description": "按表名列出普通表，跳过系统表，每页最多 100 张，可用 offset 翻页。",
      "method": "GET",
      "path": "/tables",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "每页条数"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0,
            "description": "分页偏移；读取数据时必须同时指定唯一的 order_by 字段。并发数据变动可能影响分页。"
          }
        },
        "required": [],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "describe_table",
      "description": "查看真实列名、声明类型、可空性、默认值及自动生成信息，最多 100 列。",
      "method": "GET",
      "path": "/tables/{table}/columns",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "description": "表名",
            "maxLength": 256
          }
        },
        "required": [
          "table"
        ],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "read_rows",
      "description": "按行读取表数据（宿主固定 SELECT * FROM \"table\" LIMIT n，双引号包裹标识符 + 白名单校验；连接以只读 URI 模式打开）。分页：limit（1-100）与 offset（0-10000）；分页必须指定唯一的 order_by 字段。出处：https://www.sqlite.org/lang_select.html",
      "method": "GET",
      "path": "/tables/{table}/rows",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "description": "表名",
            "maxLength": 256
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "读取行数上限"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0,
            "description": "分页偏移；读取数据时必须同时指定唯一的 order_by 字段。并发数据变动可能影响分页。"
          },
          "order_by": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "maxLength": 63,
            "description": "用于升序排列的唯一字段，例如主键；offset 大于 0 时必填。"
          }
        },
        "required": [
          "table"
        ],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "insert_row",
      "description": "按真实表结构校验字段并新增一行，先查看表结构。省略自动编号和生成列；缺少必填项时询问用户。提交结果不确定时先查回核实。",
      "method": "POST",
      "path": "/tables/{table}/rows",
      "readOnly": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"
          },
          "values": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 100,
            "additionalProperties": true
          }
        },
        "required": [
          "table",
          "values"
        ]
      }
    }
  ],
  "limitations": [
    "默认只读。单行新增需要开启写入并明确列出目标表；支持文本、整数、定点小数、日期等常用字段。不能修改或删除记录，不接受任意 SQL。",
    "查询以只读模式打开现有文件；新增需要执行机对文件及目录的写权限，不会创建缺失的数据库。",
    "最多 100 行、结果不超过 2 MB；行数上限不代表已读取整张表。",
    "数据库文件位于执行机本地，路径必须有执行机文件系统访问权限；连接器不做任何账号鉴权（SQLite 无账号体系）。",
    "数据分页需指定稳定唯一的 order_by；最多跳过 10000 行。非快照，不保证并发修改期间跨页一致。"
  ]
}
