{
  "schemaVersion": 1,
  "id": "mysql",
  "name": "MySQL",
  "category": "数据库",
  "description": "查看 MySQL 表、字段和数据，向已授权的表新增单条记录。",
  "runtimeKind": "mysql",
  "officialDocs": [
    "https://dev.mysql.com/doc/refman/8.4/en/information-schema.html",
    "https://dev.mysql.com/doc/refman/8.4/en/start-transaction.html",
    "https://dev.mysql.com/doc/refman/8.4/en/server-system-variables.html#sysvar_multiple_statements"
  ],
  "authDocs": [
    "https://dev.mysql.com/doc/refman/8.4/en/create-user.html"
  ],
  "baseUrl": "http://mysql-runtime.local",
  "fields": [
    {
      "key": "MYSQL_HOST",
      "label": "数据库主机",
      "secret": false,
      "required": true,
      "pattern": "^[a-zA-Z0-9._-]{1,253}$",
      "example": ""
    },
    {
      "key": "MYSQL_PORT",
      "label": "端口",
      "secret": false,
      "required": false,
      "pattern": "^[0-9]{2,5}$",
      "example": "",
      "default": "3306"
    },
    {
      "key": "MYSQL_DATABASE",
      "label": "默认数据库名",
      "secret": false,
      "required": true,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
      "example": ""
    },
    {
      "key": "MYSQL_USER",
      "label": "数据库用户",
      "secret": false,
      "required": true,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
      "example": ""
    },
    {
      "key": "MYSQL_PASSWORD",
      "label": "数据库密码",
      "secret": true,
      "required": true,
      "example": ""
    },
    {
      "key": "DISABLE_TLS",
      "label": "关闭 TLS（明文连接）",
      "type": "boolean",
      "secret": false,
      "required": false,
      "pattern": "^(true|false)$",
      "default": "false"
    },
    {
      "key": "TLS_CA_PEM",
      "label": "TLS CA PEM（用于验证证书，换行写作\\n）",
      "secret": false,
      "required": false,
      "example": ""
    },
    {
      "key": "MYSQL_INSERT_TABLES",
      "label": "允许新增的表（多个表名用英文逗号分隔）",
      "secret": false,
      "required": false,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}(?: *, *[A-Za-z_][A-Za-z0-9_]{0,62})*$",
      "example": "city, product"
    }
  ],
  "auth": {
    "type": "none"
  },
  "headers": {},
  "tools": [
    {
      "name": "list_tables",
      "description": "列出最多 100 张基础表，不执行任意 SQL。 支持 offset（0-10000）按表名分页。",
      "method": "GET",
      "path": "/tables",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50,
            "description": "每页条数"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0,
            "description": "分页偏移；读取数据时必须同时指定唯一的 order_by 字段。并发数据变动可能影响分页。"
          }
        },
        "required": [],
        "maxProperties": 50
      },
      "query": {
        "limit": "limit",
        "offset": "offset"
      },
      "readOnly": true
    },
    {
      "name": "describe_table",
      "description": "查看当前库中的列、类型、长度、精度、可空性、默认值及自增等属性，最多 100 列。",
      "method": "GET",
      "path": "/tables/{table}/columns",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "description": "表名（当前库内）",
            "maxLength": 10000
          }
        },
        "required": [
          "table"
        ],
        "maxProperties": 50
      },
      "readOnly": true
    },
    {
      "name": "read_rows",
      "description": "按行读取表数据（宿主固定 SELECT … FROM `database`.`table` LIMIT n，反引号包裹标识符 + 白名单校验 + 只读事务）。分页：limit（1-100）与 offset（0-10000）；分页必须指定唯一的 order_by 字段。出处：https://dev.mysql.com/doc/refman/8.4/en/select.html",
      "method": "GET",
      "path": "/tables/{table}/rows",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "description": "表名（当前库内）",
            "maxLength": 10000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "description": "读取行数上限"
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0,
            "description": "分页偏移；读取数据时必须同时指定唯一的 order_by 字段。并发数据变动可能影响分页。"
          },
          "order_by": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
            "maxLength": 63,
            "description": "用于升序排列的唯一字段，例如主键；offset 大于 0 时必填。"
          }
        },
        "required": [
          "table"
        ],
        "maxProperties": 50
      },
      "query": {
        "limit": "limit",
        "offset": "offset"
      },
      "readOnly": true
    },
    {
      "name": "insert_row",
      "description": "根据用户明确给出的字段值向一张已授权的表新增一行。先用 describe_table 确认字段，缺少必填值时询问用户。自增列和生成列应省略；精确小数可传字符串。返回写入行数及自增 ID。结果不确定时先查询核实。",
      "method": "POST",
      "path": "/tables/{table}/rows",
      "readOnly": false,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$"},
          "values": {"type": "object", "minProperties": 1, "maxProperties": 100, "additionalProperties": true}
        },
        "required": ["table", "values"]
      }
    }
  ],
  "limitations": [
    "查询默认只读。新增需要开启写入、填写允许新增的表，并授予数据库账号对应 InnoDB 表的 SELECT 和 INSERT 权限。每次最多新增一行，支持文本、整数、定点小数和日期。",
    "远程连接默认使用 TLS 并校验证书与主机名。数据库未启用 TLS 时，可在高级设置中选择明文连接。",
    "需升级包含 pg8000 / PyMySQL 的 Runner；最多 100 行、结果不超过 2 MB。",
    "尚未使用真实业务数据库授权验证。",
    "数据分页需指定稳定唯一的 order_by；最多跳过 10000 行。非快照，不保证并发修改期间跨页一致。"
  ]
}
